+            if(mask&0x10000000U){result=-17;goto done;}
+            w->mask=(mask&0x20000000U)?w->mask|(mask&(LINUX_IN_ALL_EVENTS|LINUX_IN_ONESHOT))
+                :mask&(LINUX_IN_ALL_EVENTS|LINUX_IN_ONESHOT);
