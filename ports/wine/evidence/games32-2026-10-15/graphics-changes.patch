+/* contexts_lock protects the drawable registry and binding references.
+ * A destroyed/resized drawable survives until all bound contexts release it. */
+static void release_drawable(struct bles_drawable *b){
+    if(!b)return;
+    if(b->refs)--b->refs;
+    if(b->refs || !b->retired)return;
+    struct bles_drawable **link=&drawables;
+    while(*link && *link!=b)link=&(*link)->next;
+    if(*link)*link=b->next;
+    destroy_drawable(b->mesa);free(b->pixels);free(b);
+}
+static void retire_drawable(Display *d,GLXDrawable xid){
+    pthread_mutex_lock(&contexts_lock);
+    struct bles_drawable *b=drawables,*next;
+    while(b){next=b->next;if(b->display==d && b->xid==xid){b->retired=1;if(!b->refs)release_drawable(b);}b=next;}
+    pthread_mutex_unlock(&contexts_lock);
+}
+static struct bles_drawable *acquire_drawable(Display *d,GLXDrawable xid,GLXContext c,unsigned w,unsigned h){
+    struct bles_drawable *b=drawables,*next;
+    while(b){
+        next=b->next;
+        if(!b->retired && b->display==d && b->xid==xid){
+            if(b->width==w && b->height==h && b->doublebuffer==c->doublebuffer){b->refs++;return b;}
+            b->retired=1;if(!b->refs)release_drawable(b);
+        }
+        b=next;
+    }
+    b=calloc(1,sizeof(*b));if(!b)return NULL;
+    b->pixels=calloc((size_t)w*h,4);
+    if(b->pixels)b->mesa=create_drawable(c->mesa,b->pixels,GL_UNSIGNED_BYTE,w,h);
+    if(!b->mesa){free(b->pixels);free(b);return NULL;}
+    b->display=d;b->xid=xid;b->width=w;b->height=h;b->refs=1;b->doublebuffer=c->doublebuffer;
+    b->next=drawables;drawables=b;return b;
+}
+static void release_binding(GLXContext c){
+    if(!c)return;
+    release_drawable(c->draw_buffer);release_drawable(c->read_buffer);
+    c->draw_buffer=c->read_buffer=NULL;
+}
