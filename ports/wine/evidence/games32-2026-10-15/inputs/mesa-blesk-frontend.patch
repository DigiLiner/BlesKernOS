+GLAPI OSMesaContext GLAPIENTRY OSMesaBleskCreateContextAttribs(const int *, OSMesaContext);
+GLAPI OSMesaContext GLAPIENTRY
+OSMesaBleskCreateContextAttribs(const int *attributes, OSMesaContext share)
+{ return OSMesaCreateContextAttribs(attributes, share); }
+
+/* Copy-swap: front and back are distinct GPU resources. Retain back-buffer
+ * contents. Queue the copy after Mesa drains its vertices, but before the
+ * one pipe flush, rather than synchronously submitting draws and copy apart. */
+struct bles_swap { OSMesaContext osmesa; bool ok; };
+static void osmesa_bles_copy_front(void *data)
+{
+   struct bles_swap *swap = data;
+   OSMesaContext osmesa = swap->osmesa;
+   struct osmesa_buffer *b = osmesa->current_buffer;
+   if (osmesa->double_buffer) {
+      struct pipe_resource *front=b->textures[ST_ATTACHMENT_FRONT_LEFT];
+      struct pipe_resource *back=b->textures[ST_ATTACHMENT_BACK_LEFT];
+      if (!back) return;
+      if (!front) {
+         enum st_attachment_type attachment=ST_ATTACHMENT_FRONT_LEFT;
+         struct pipe_resource *created=NULL;
+         if (!osmesa_st_framebuffer_validate(osmesa->st, &b->base, &attachment, 1, &created, NULL))
+            return;
+         pipe_resource_reference(&created, NULL);
+         front=b->textures[ST_ATTACHMENT_FRONT_LEFT];
+      }
+      struct pipe_box box={.x=0,.y=0,.z=0,.width=b->width,.height=b->height,.depth=1};
+      osmesa->st->pipe->resource_copy_region(osmesa->st->pipe,front,0,0,0,0,back,0,&box);
+   }
+   swap->ok = true;
+}
+
+GLAPI GLboolean GLAPIENTRY OSMesaBleskSwapBuffers(OSMesaContext);
+GLAPI GLboolean GLAPIENTRY OSMesaBleskSwapBuffers(OSMesaContext osmesa)
+{
+   if (!osmesa || osmesa != OSMesaGetCurrentContext() || !osmesa->current_buffer)
+      return GL_FALSE;
+   struct bles_swap swap = {osmesa, false};
+   st_context_flush(osmesa->st, ST_FLUSH_END_OF_FRAME, NULL, osmesa_bles_copy_front, &swap);
+   if (!swap.ok) return GL_FALSE;
+   return osmesa_st_framebuffer_flush_front(osmesa->st,&osmesa->current_buffer->base,ST_ATTACHMENT_FRONT_LEFT);
+}
